---
import { business } from '../data/business';
interface Props { title?: string; text?: string; }
const { title = 'Need a plumber or heating contractor in Livingston?', text = `Call ${business.shortName} for straight answers and a fair price on water heaters, boilers and plumbing repairs.` } = Astro.props;
---
<section class="section section--navy">
  <div class="container cta">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href={`tel:${business.phoneTel}`}>Call {business.phoneDisplay}</a>
      <a class="btn btn--outline" href="/contact/">Contact Us</a>
    </div>
  </div>
</section>
<style>
  .cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 24px; }
  .cta .lead { margin: 0; }
  .cta .btn-row { margin: 0; }
</style>
